{
  "name": "google-drive-sync",
  "version": "7.0.4",
  "description": "Share your Google Drive files with this daemon to have them saved to disk as JSON.",
  "bin": {
    "google-drive-sync": "lib/cli.js",
    "google-drive-sync-convert": "lib/convert-cli.js"
  },
  "main": "lib/index.js",
  "scripts": {
    "compile": "babel -d lib/ src/",
    "prepare": "npm run compile",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git@githubcom:jarib/google-drive-sync.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "babel": {
    "presets": [
      "@babel/env"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/*-test.js"
    ]
  },
  "author": "Jari Bakken <jari.bakken@gmail.com>",
  "license": "BSD-3-Clause",
  "keywords": [
    "google",
    "drive",
    "google-drive",
    "archieml",
    "json",
    "docs",
    "sheets",
    "spreadsheets",
    "excel",
    "xlsx"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "archieml": "^0.4.2",
    "archieml-new": "npm:archieml@^0.5.0",
    "bluebird": "^3.7.2",
    "daemon": "^1.1.0",
    "debug": "^4.4.3",
    "fs-extra": "^4.0.3",
    "google-auth-library": "^9.15.1",
    "googleapis": "^129.0.0",
    "html-entities": "^1.4.0",
    "htmlparser2": "^3.10.1",
    "lodash.zip": "^4.2.0",
    "moment": "^2.30.1",
    "ms": "^2.1.3",
    "stream-buffers": "^3.0.3",
    "underscore": "^1.13.8",
    "yargs": "^15.4.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.29.5",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "node-fetch": "^2.7.0"
  }
}
